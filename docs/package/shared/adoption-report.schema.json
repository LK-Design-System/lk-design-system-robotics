{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-design-system.github.io/lk-design-system/schemas/lds-ui-adoption-report.schema.json",
  "title": "LDS UI adoption report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "contractVersion", "id", "scope", "surfaces", "exceptions"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-ui-adoption-report" },
    "contractVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "scope": { "$ref": "#/$defs/scope" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "paths"],
      "properties": {
        "mode": { "enum": ["changed-ui", "full-surface"], "default": "full-surface" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/exclusion" }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reasonCode", "detail"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "reasonCode": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "detail": { "type": "string", "minLength": 10 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "facets", "componentMapping", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "facets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tokensAndTheme",
            "layoutAndVisualFoundations",
            "statePatternsAndMotion",
            "assetsIconographyAndBrand",
            "contentAndInternationalization",
            "accessibility"
          ],
          "properties": {
            "tokensAndTheme": { "$ref": "#/$defs/tokensAndThemeDecision" },
            "layoutAndVisualFoundations": { "$ref": "#/$defs/layoutAndVisualFoundationsDecision" },
            "statePatternsAndMotion": { "$ref": "#/$defs/statePatternsAndMotionDecision" },
            "assetsIconographyAndBrand": { "$ref": "#/$defs/assetsIconographyAndBrandDecision" },
            "contentAndInternationalization": { "$ref": "#/$defs/contentAndInternationalizationDecision" },
            "accessibility": { "$ref": "#/$defs/accessibilityDecision" }
          }
        },
        "componentMapping": { "$ref": "#/$defs/componentMappingDecision" },
        "verification": { "$ref": "#/$defs/verification" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence"],
      "properties": {
        "verdict": { "enum": ["reviewed", "not-applicable", "blocked"] },
        "reasonCode": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "detail": { "type": "string", "minLength": 10 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionOutcome" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "not-applicable" } }, "required": ["verdict"] },
          "then": {
            "required": ["reasonCode", "detail"],
            "properties": {
              "reasonCode": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "reviewed" } }, "required": ["verdict"] },
          "then": {
            "required": ["detail", "decisions"],
            "properties": {
              "detail": { "type": "string", "minLength": 20 },
              "evidence": { "type": "array", "minItems": 1 },
              "decisions": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "blocked" } }, "required": ["verdict"] },
          "then": {
            "required": ["detail"],
            "properties": { "detail": { "type": "string" } }
          }
        }
      ]
    },
    "componentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "evidence"],
      "properties": {
        "verdict": { "enum": ["reviewed", "blocked"] },
        "detail": { "type": "string", "minLength": 10 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/decisionOutcome" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "reviewed" } }, "required": ["verdict"] },
          "then": {
            "required": ["detail", "decisions"],
            "properties": {
              "detail": { "type": "string", "minLength": 20 },
              "evidence": { "type": "array", "minItems": 1 },
              "decisions": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "blocked" } }, "required": ["verdict"] },
          "then": {
            "required": ["detail"],
            "properties": { "detail": { "type": "string" } }
          }
        }
      ]
    },
    "decisionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "outcome", "evidence"],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "outcome": { "type": "string", "minLength": 10 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" },
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "enum": ["source", "token", "story", "check", "visual", "asset", "copy-catalog"]
              }
            }
          },
          "minContains": 1
        }
      }
    },
    "tokensAndThemeDecisions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/decisionOutcome" },
      "allOf": [
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "owner-package-css-order" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "font-theme-scope" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "color-scheme-behavior" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "token-mapping" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "raw-visual-literals" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "layoutAndVisualFoundationsDecisions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/decisionOutcome" },
      "allOf": [
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "semantic-reading-order" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "grid-container-mapping" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "responsive-overflow-ownership" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "typography-data-formatting" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "visual-foundation-mapping" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "statePatternsAndMotionDecisions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/decisionOutcome" },
      "allOf": [
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "async-state-model" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "loading-pattern-scope" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "retained-content-refresh" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "motion-reduced-motion" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "assetsIconographyAndBrandDecisions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/decisionOutcome" },
      "allOf": [
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "registry-search" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "asset-owner-public-path" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "provenance-license" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "asset-semantics-alt" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "theme-suitability" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "contentAndInternationalizationDecisions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/decisionOutcome" },
      "allOf": [
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "copy-product-truth" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "writing-voice" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "locale-language-boundary" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "data-formatting" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "translation-truncation" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "accessibilityDecisions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/decisionOutcome" },
      "allOf": [
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "landmarks-dom-order" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "keyboard-focus-restoration" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "accessible-name-role-state" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "target-pointer-alternatives" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "contrast-non-color-cues" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "reduced-motion" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "componentMappingDecisions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/decisionOutcome" },
      "allOf": [
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "owner-public-export" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "reuse-composition-choice" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "product-orchestration-boundary" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "required": ["decisionId"], "properties": { "decisionId": { "const": "exception-shared-authoring" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "tokensAndThemeDecision": { "allOf": [{ "$ref": "#/$defs/decision" }, { "type": "object", "properties": { "decisions": { "$ref": "#/$defs/tokensAndThemeDecisions" } } }] },
    "layoutAndVisualFoundationsDecision": { "allOf": [{ "$ref": "#/$defs/decision" }, { "type": "object", "properties": { "decisions": { "$ref": "#/$defs/layoutAndVisualFoundationsDecisions" } } }] },
    "statePatternsAndMotionDecision": { "allOf": [{ "$ref": "#/$defs/decision" }, { "type": "object", "properties": { "decisions": { "$ref": "#/$defs/statePatternsAndMotionDecisions" } } }] },
    "assetsIconographyAndBrandDecision": { "allOf": [{ "$ref": "#/$defs/decision" }, { "type": "object", "properties": { "decisions": { "$ref": "#/$defs/assetsIconographyAndBrandDecisions" } } }] },
    "contentAndInternationalizationDecision": { "allOf": [{ "$ref": "#/$defs/decision" }, { "type": "object", "properties": { "decisions": { "$ref": "#/$defs/contentAndInternationalizationDecisions" } } }] },
    "accessibilityDecision": { "allOf": [{ "$ref": "#/$defs/decision" }, { "type": "object", "properties": { "decisions": { "$ref": "#/$defs/accessibilityDecisions" } } }] },
    "componentMappingDecision": { "allOf": [{ "$ref": "#/$defs/componentDecision" }, { "type": "object", "properties": { "decisions": { "$ref": "#/$defs/componentMappingDecisions" } } }] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["source", "token", "story", "check", "visual", "asset", "copy-catalog", "decision"] },
        "ref": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 3 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports", "viewportDisposition", "themes", "themeDisposition", "states", "stateDisposition", "evidence"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[1-9][0-9]*x[1-9][0-9]*$" }
        },
        "viewportDisposition": { "type": "string", "minLength": 10 },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark", "auto", "inverse", "not-applicable"] }
        },
        "themeDisposition": { "type": "string", "minLength": 10 },
        "states": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 },
          "contains": { "const": "ready" },
          "minContains": 1,
          "maxContains": 1,
          "allOf": [
            {
              "contains": { "enum": ["loading", "empty", "error", "stale", "offline", "disabled", "recovery"] },
              "minContains": 1
            }
          ]
        },
        "stateDisposition": { "type": "string", "minLength": 10 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" },
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "enum": ["visual", "story", "check"] } }
          },
          "minContains": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "themes": { "type": "array", "contains": { "const": "not-applicable" } } },
            "required": ["themes"]
          },
          "then": { "properties": { "themes": { "type": "array", "maxItems": 1 } } },
          "else": {
            "properties": {
              "themes": {
                "type": "array",
                "allOf": [
                  { "contains": { "const": "light" }, "minContains": 1 },
                  { "contains": { "const": "dark" }, "minContains": 1 }
                ]
              }
            }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "path", "signature", "owner", "reason", "expiresAt"],
      "properties": {
        "rule": { "type": "string", "minLength": 2 },
        "path": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "owner": { "type": "string", "minLength": 2 },
        "reason": { "type": "string", "minLength": 10 },
        "expiresAt": { "type": "string", "format": "date" }
      }
    }
  }
}
