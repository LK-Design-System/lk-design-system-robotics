{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-design-system.github.io/lk-design-system/schemas/lds-ui-adoption-config.schema.json",
  "title": "LDS UI adoption consumer config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "repository",
    "uiRoots",
    "styleEntry",
    "requiredStyleImports",
    "excludedPaths",
    "reportDirectory"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-ui-adoption-config" },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "uiRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "styleEntry": { "$ref": "#/$defs/repositoryPath" },
    "requiredStyleImports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "excludedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryPath" }
    },
    "reportDirectory": { "$ref": "#/$defs/repositoryPath" }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    }
  }
}
