{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-design-system.github.io/lk-design-system/schemas/lds-ui-adoption-contract.schema.json",
  "title": "LDS UI adoption contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "contractVersion",
    "invariant",
    "triggers",
    "scopeModes",
    "verdicts",
    "evidenceKinds",
    "facets",
    "componentMapping",
    "completion"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lds-ui-adoption-contract" },
    "contractVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "invariant": { "type": "string", "minLength": 20 },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "scopeModes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "fullSurfaceRule", "changedUiRule"],
      "properties": {
        "default": { "const": "full-surface" },
        "fullSurfaceRule": { "type": "string", "minLength": 40 },
        "changedUiRule": { "type": "string", "minLength": 40 }
      }
    },
    "verdicts": {
      "type": "array",
      "const": ["reviewed", "not-applicable", "blocked"]
    },
    "evidenceKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["source", "token", "story", "check", "visual", "asset", "copy-catalog", "workflow", "decision"]
      }
    },
    "facets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/facet" }
    },
    "componentMapping": { "$ref": "#/$defs/componentMapping" },
    "completion": { "$ref": "#/$defs/completion" }
  },
  "$defs": {
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "foundationIds", "requiredDecisions", "references", "hardTriggers"],
      "properties": {
        "id": {
          "enum": [
            "tokensAndTheme",
            "layoutAndVisualFoundations",
            "statePatternsAndMotion",
            "assetsIconographyAndBrand",
            "contentAndInternationalization",
            "accessibility"
          ]
        },
        "title": { "type": "string", "minLength": 3 },
        "purpose": { "type": "string", "minLength": 20 },
        "foundationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "requiredDecisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requiredDecision" }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "hardTriggers": {
          "type": "array",
          "items": { "$ref": "#/$defs/hardTrigger" }
        }
      }
    },
    "hardTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fact", "requiredEvidenceKinds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "fact": { "type": "string", "minLength": 10 },
        "requiredEvidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["source", "token", "story", "check", "visual", "asset", "copy-catalog", "workflow", "decision"]
          }
        },
        "requiredAnyOfEvidenceKinds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["source", "token", "story", "check", "visual", "asset", "copy-catalog", "workflow", "decision"]
          }
        }
      }
    },
    "requiredDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 3 }
      }
    },
    "componentMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "purpose", "requiredDecisions", "references"],
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "purpose": { "type": "string", "minLength": 20 },
        "requiredDecisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requiredDecision" }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFacetIds", "requiresComponentMapping", "blockedVerdictFails", "notApplicableRequiresReason", "exceptionRequirements", "verification"],
      "properties": {
        "requiredFacetIds": {
          "type": "array",
          "const": [
            "tokensAndTheme",
            "layoutAndVisualFoundations",
            "statePatternsAndMotion",
            "assetsIconographyAndBrand",
            "contentAndInternationalization",
            "accessibility"
          ]
        },
        "requiresComponentMapping": { "const": true },
        "blockedVerdictFails": { "const": true },
        "notApplicableRequiresReason": { "const": true },
        "exceptionRequirements": {
          "type": "array",
          "const": ["rule", "path", "signature", "owner", "reason", "expiresAt"]
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
