{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lk-robotics.local/schemas/foundation-content.schema.json",
  "title": "LK Design System Foundation content",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "title", "completionCriteria", "foundations"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "completionCriteria": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "foundations": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/foundation" }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "path": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "required": ["url"],
          "properties": { "url": { "type": "string", "format": "uri" } }
        },
        {
          "required": ["path"],
          "properties": { "path": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "status",
        "purpose",
        "principles",
        "semanticModel",
        "selectionCriteria",
        "quantitativeRules",
        "doDont",
        "exceptions",
        "accessibility",
        "internationalization",
        "examples",
        "tokens",
        "apis",
        "sources"
      ],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "const": "current" },
        "purpose": { "type": "string", "minLength": 40 },
        "principles": { "$ref": "#/$defs/nonEmptyStrings" },
        "semanticModel": { "$ref": "#/$defs/rows" },
        "selectionCriteria": { "$ref": "#/$defs/rows" },
        "quantitativeRules": { "$ref": "#/$defs/rows" },
        "doDont": { "$ref": "#/$defs/rows" },
        "exceptions": { "$ref": "#/$defs/nonEmptyStrings" },
        "accessibility": { "$ref": "#/$defs/nonEmptyStrings" },
        "internationalization": { "$ref": "#/$defs/nonEmptyStrings" },
        "examples": { "$ref": "#/$defs/rows" },
        "tokens": { "$ref": "#/$defs/nonEmptyStrings" },
        "apis": { "$ref": "#/$defs/nonEmptyStrings" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
