{
  "name": "@lk-robotics/lds-robotics-ui",
  "version": "0.1.0-rc.3",
  "description": "Robotics DOM, SVG, and 2D UI presentation layer for LDS.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "tokens",
    "vendor",
    "licenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-types.mjs",
    "storybook": "storybook dev -p 6008 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "capture:visual-smoke": "node scripts/capture-visual-smoke.mjs",
    "check:visual-regression": "node scripts/capture-visual-smoke.mjs --check",
    "update:visual-baseline": "npm run build:storybook && node scripts/capture-visual-smoke.mjs --update-baseline",
    "check:storybook": "npm run build:storybook && node scripts/check-owner-boundaries.mjs --storybook-index storybook-static/index.json && npm run check:representative-stories && npm run check:story-play",
    "check:representative-stories": "node scripts/check-lds-style.mjs --storybook-index storybook-static/index.json --require-built-stories",
    "check:story-play": "node scripts/check-story-play.mjs",
    "check:lds-style": "node scripts/check-lds-style.mjs",
    "check:ownership": "node scripts/check-owner-boundaries.mjs",
    "check:coordinates": "node scripts/check-navigation-coordinates.mjs",
    "check:navigation-graph": "node scripts/check-navigation-graph.mjs",
    "check:navigation-encoding": "node scripts/check-navigation-encoding.mjs",
    "check:types": "tsc --noEmit",
    "check:pack": "npm pack --dry-run --ignore-scripts",
    "check": "npm run check:lds-style && npm run check:module-graph && npm run check:ownership && npm run check:coordinates && npm run check:navigation-graph && npm run check:navigation-encoding && npm run build && npm run check:types && npm run check:pack",
    "prepublishOnly": "npm run check",
    "check:module-graph": "node scripts/check-story-module-graph.mjs"
  },
  "dependencies": {
    "@lk-robotics/lds-core": "0.1.0-rc.3",
    "@lk-robotics/lds-product": "0.1.0-rc.3"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@lk-robotics/lds-theme": "0.1.0-rc.3",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "storybook": "10.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "8.1.3"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "esbuild": "0.28.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*"
  }
}
