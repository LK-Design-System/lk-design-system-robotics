{
  "name": "@lk-robotics/lds-robotics-ui",
  "version": "0.1.0-rc.1",
  "description": "Robotics DOM, SVG, and 2D UI presentation layer for LDS.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "tokens"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/copy-types.mjs",
    "storybook": "storybook dev -p 6008 --host 127.0.0.1 --no-open",
    "build:storybook": "storybook build",
    "check:storybook": "storybook build",
    "check:types": "tsc --noEmit",
    "check:pack": "npm pack --dry-run --ignore-scripts",
    "check": "npm run build && npm run check:types && npm run check:pack",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@lk-robotics/lds-core": "0.1.0-rc.0",
    "@lk-robotics/lds-product": "0.1.0-rc.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@lk-robotics/lds-theme": "0.1.0-rc.0",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "storybook": "10.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "8.1.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*"
  }
}
