{
  "name": "@lk-robotics/lds-robotics-ui",
  "version": "0.1.0",
  "description": "Robotics DOM, SVG, and 2D UI presentation layer for LDS.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "tokens"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "dependencies": {
    "@lk-robotics/lds-core": "0.1.0",
    "@lk-robotics/lds-product": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*"
  }
}
