{
  "name": "@lk-design-system/lds-robotics-ui",
  "version": "0.1.0-rc.33",
  "description": "Robotics DOM, SVG, and 2D UI presentation layer for LDS.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "llms.txt",
    "docs/package",
    "dist",
    "styles.css",
    "tokens",
    "licenses",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "*.css",
    "tokens/*.css"
  ],
  "scripts": {
    "generate:docs": "node scripts/project-package-docs.mjs",
    "check:docs": "node scripts/check-package-docs.mjs",
    "project:storybook-docs": "node scripts/project-storybook-docs.mjs",
    "prestorybook": "npm run generate:docs && npm run project:storybook-docs",
    "build": "tsup --config tsup.config.ts && node scripts/copy-types.mjs",
    "storybook": "storybook dev -p 6008 --host 127.0.0.1 --no-open",
    "prebuild:storybook": "npm run generate:docs && npm run project:storybook-docs",
    "build:storybook": "storybook build",
    "capture:visual-smoke": "node scripts/capture-visual-smoke.mjs",
    "check:visual-regression": "node scripts/capture-visual-smoke.mjs --check",
    "update:visual-baseline": "npm run build:storybook && node scripts/capture-visual-smoke.mjs --update-baseline",
    "check:storybook-docs": "node scripts/check-storybook-docs.mjs",
    "check:storybook:local": "npm run build:storybook && npm run check:storybook-docs && node scripts/check-owner-boundaries.mjs --storybook-index storybook-static/index.json && npm run check:story-play",
    "check:storybook": "npm run check:storybook:local && npm run check:representative-stories",
    "check:representative-stories": "node scripts/check-lds-style.mjs --storybook-index storybook-static/index.json --require-built-stories",
    "check:story-play": "node scripts/check-story-play.mjs",
    "check:lds-style": "node scripts/check-lds-style.mjs",
    "check:ownership": "node scripts/check-owner-boundaries.mjs",
    "check:coordinates": "node scripts/check-navigation-coordinates.mjs",
    "check:navigation-graph": "node scripts/check-navigation-graph.mjs",
    "check:navigation-encoding": "node scripts/check-navigation-encoding.mjs",
    "check:types": "tsc --noEmit",
    "check:pack": "node scripts/check-packed-docs.mjs",
    "check:local": "npm run check:docs && npm run check:module-graph && npm run check:ownership && npm run check:coordinates && npm run check:navigation-graph && npm run check:navigation-encoding && npm run build && npm run check:types && npm run check:pack",
    "check": "npm run check:lds-style && npm run check:local",
    "check:release": "node scripts/check-release-conformance-pin.mjs && npm run check",
    "prepublishOnly": "npm run check:release",
    "check:module-graph": "node scripts/check-story-module-graph.mjs"
  },
  "peerDependencies": {
    "@lk-design-system/lds-core": ">=0.1.0-rc.69.31 <0.2.0",
    "@lk-design-system/lds-product": ">=0.1.0-rc.69.31 <0.2.0",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@lk-design-system/lds-theme": "0.1.0-rc.69.31",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "storybook": "10.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "8.1.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json",
    "./design-system.json": "./docs/package/manifest.json",
    "./llms.txt": "./docs/package/llms.txt",
    "./adoption-checklist.json": "./docs/package/adoption-checklist.json",
    "./docs/*": "./docs/package/*"
  },
  "lds": {
    "schemaVersion": 1,
    "layer": "robotics",
    "refStatus": "published",
    "manifest": "./docs/package/manifest.json",
    "llms": "./docs/package/llms.txt",
    "adoptionChecklist": "./docs/package/adoption-checklist.json",
    "adoptionReportSchema": "./docs/package/adoption-report.schema.json",
    "storybook": "https://lk-design-system.github.io/lk-design-system-robotics/?path=/docs/lds-robotics-foundation-viewer-tokens--docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LK-Design-System/lk-design-system-robotics.git"
  },
  "homepage": "https://lk-design-system.github.io/lk-design-system-robotics/?path=/docs/lds-robotics-foundation-viewer-tokens--docs",
  "bugs": {
    "url": "https://github.com/LK-Design-System/lk-design-system-robotics/issues"
  }
}
